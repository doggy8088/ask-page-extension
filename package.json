{
  "name": "ask-page-extension",
  "version": "0.53.0",
  "description": "使用 Gemini API、OpenAI API、Azure OpenAI API 或 OpenAI Compatible API 詢問關於目前頁面的問題",
  "main": "src/background.js",
  "scripts": {
    "bump:patch": "node scripts/bump-version.js patch",
    "bump:minor": "node scripts/bump-version.js minor",
    "bump:major": "node scripts/bump-version.js major",
    "lint": "eslint src/*.js src/lib/dialog-key-isolation.js platforms/*/*.js scripts/*.js && npm run lint:governance && npm run lint:anthropic && npm run lint:debug && npm run lint:skills",
    "lint:fix": "eslint src/*.js src/lib/dialog-key-isolation.js platforms/*/*.js scripts/*.js --fix && npm run lint:governance && npm run lint:anthropic && npm run lint:debug && npm run lint:skills",
    "lint:governance": "eslint src/lib/tool-policy.js src/lib/tool-governance.js",
    "lint:anthropic": "eslint src/lib/anthropic-tools.js",
    "lint:debug": "eslint src/lib/debug-logger.js src/lib/debug-console.js",
    "lint:skills": "eslint src/lib/skill-schema.js",
    "build": "npm run lint && node scripts/build.js",
    "build:chrome": "node scripts/build.js --target=chrome",
    "build:edge": "node scripts/build.js --target=edge",
    "build:safari": "node scripts/build.js --target=safari",
    "package": "node scripts/package.js",
    "test": "node scripts/build.js && node tests/run-all.js",
    "clean": "rm -rf dist/ node_modules/ *.zip"
  },
  "keywords": [
    "chrome-extension",
    "ai",
    "gemini",
    "openai",
    "web-extension",
    "browser-extension",
    "chatgpt",
    "multi-provider"
  ],
  "author": "AskPage Team",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.57.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/doggy8088/ask-page-extension.git"
  },
  "bugs": {
    "url": "https://github.com/doggy8088/ask-page-extension/issues"
  },
  "homepage": "https://github.com/doggy8088/ask-page-extension",
  "engines": {
    "node": ">=18.0.0"
  }
}
