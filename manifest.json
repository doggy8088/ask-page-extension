{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.39.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "zh_TW",
  "permissions": [
    "storage",
    "activeTab",
    "userScripts"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "minimum_chrome_version": "135",
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "lib/highlight.min.js",
        "lib/marked.min.js",
        "lib/purify.min.js",
        "lib/katex/katex.min.js",
        "lib/katex/auto-render.min.js",
        "i18n.js",
        "content.js"
      ]
    }
  ],
  "commands": {
    "toggle-dialog": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "__MSG_commandToggleDialog__"
    },
    "switch-provider": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "MacCtrl+Shift+S"
      },
      "description": "__MSG_commandSwitchProvider__"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "style.css",
        "icons/askpage-mark.png",
        "icons/icon16.png",
        "icons/icon32.png",
        "icons/icon48.png",
        "icons/icon128.png",
        "lib/marked.min.js",
        "lib/purify.min.js",
        "lib/katex/katex.min.css",
        "lib/katex/fonts/*.woff2"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
